{
  "name": "@nyc-merge/source",
  "version": "0.1.1",
  "license": "MIT",
  "scripts": {
    "docs": "cp README.md LICENSE packages/nyc-merge",
    "lib:local:publish": "nx build nyc-merge && npm run docs && cd packages/nyc-merge/dist && npm publish --registry http://localhost:4873",
    "lib:publish": "nx build nyc-merge && npm run docs && cd packages/nyc-merge/dist && npm publish --access=public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nx/eslint": "20.7.0",
    "@nx/eslint-plugin": "20.7.0",
    "@nx/jest": "20.7.0",
    "@nx/js": "20.7.0",
    "@swc-node/register": "~1.9.2",
    "@swc/core": "~1.5.29",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "18.16.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.2",
    "nx": "20.7.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.6",
    "ts-node": "10.9.1",
    "tslib": "^2.8.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.53.1",
    "verdaccio": "^6.2.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
